{
  "name": "repoexe",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun scripts/cli/build.ts",
    "audit": "bun scripts/cli/build.ts check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "shards": "bun scripts/cli/generate_shards.ts",
    "abi-check": "bun scripts/cli/abi_check.ts",
    "index": "bun scripts/cli/index_gen.ts",
    "prune": "bun scripts/cli/prune.ts",
    "build:site": "bun build scripts/site/app.ts --outdir site --target browser",
    "test:watch": "bun test --parallel --watch",
    "pre-commit": "bun scripts/hooks/pre-commit.ts",
    "postinstall": "bun scripts/hooks/postinstall.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "latest"
  }
}
