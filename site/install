#!/bin/bash
# Universal RepoExe Installation Script
# Auto-detects APT vs Pacman vs APK

set -e

echo "Starting RepoExe Installation..."

if command -v pkg >/dev/null 2>&1; then
    PM="pkg"
elif command -v apt >/dev/null 2>&1; then
    PM="apt"
elif command -v pacman >/dev/null 2>&1; then
    PM="pacman"
elif command -v apk >/dev/null 2>&1; then
    PM="apk"
else
    echo "Error: No supported package manager found."
    exit 1
fi

echo "Detected package manager: $PM"
# TODO: Implement secure key downloading and repository configuration

echo "RepoExe repository configured successfully."
