#!/bin/sh
set -e

echo "Configuring RepoExe universal Android/Termux repository environment..."

# 1. APT Configuration
if command -v pkg >/dev/null 2>&1 || [ -d "$PREFIX/etc/apt" ]; then
  echo "Setting up APT repository..."
  curl -fsSL https://sjnexe.github.io/RepoExe/repoexe.gpg -o $PREFIX/etc/apt/trusted.gpg.d/repoexe.gpg 2>/dev/null || true
  echo "deb [arch=aarch64] https://sjnexe.github.io/RepoExe/apt stable main" > $PREFIX/etc/apt/sources.list.d/repoexe.list
  pkg update -y 2>/dev/null || true
fi

# 2. Pacman Configuration
if command -v pacman >/dev/null 2>&1; then
  echo "Setting up Pacman repository..."
  if ! grep -q "RepoExe" /etc/pacman.conf 2>/dev/null; then
    echo -e "\n[repoexe]\nSigLevel = Optional TrustAll\nServer = https://sjnexe.github.io/RepoExe/pacman" >> /etc/pacman.conf
  fi
  pacman -Sy --noconfirm 2>/dev/null || true
fi

# 3. Alpine APK Configuration
if command -v apk >/dev/null 2>&1; then
  echo "Setting up Alpine APK repository..."
  if ! grep -q "RepoExe" /etc/apk/repositories 2>/dev/null; then
    echo "https://sjnexe.github.io/RepoExe/alpine" >> /etc/apk/repositories
  fi
  apk update 2>/dev/null || true
fi

# 4. Python (Pip & uv) Configuration
echo "Setting up global Python Extra Index URL..."
mkdir -p ~/.config/pip
if ! grep -q "extra-index-url" ~/.config/pip/pip.conf 2>/dev/null; then
  cat << 'PIP_EOF' >> ~/.config/pip/pip.conf
[global]
extra-index-url = https://sjnexe.github.io/RepoExe/pip/
PIP_EOF
fi

# Configure UV_EXTRA_INDEX_URL in shell rc
for rc in ~/.bashrc ~/.zshrc; do
  if [ -f "$rc" ] && ! grep -q "UV_EXTRA_INDEX_URL" "$rc"; then
    echo 'export UV_EXTRA_INDEX_URL="https://sjnexe.github.io/RepoExe/pip/"' >> "$rc"
  fi
done

# 5. Node.js & Bun Configuration
echo "Setting up global NPM & Bun registry with official fallback..."
if command -v npm >/dev/null 2>&1; then
  npm config set registry https://sjnexe.github.io/RepoExe/npm/ 2>/dev/null || true
fi

mkdir -p ~/.config/bun
cat << 'BUN_EOF' > ~/.bunconfig.toml
[install]
registry = "https://sjnexe.github.io/RepoExe/npm/"
BUN_EOF

echo "✓ RepoExe environment configured successfully!"
