#!/bin/bash
set -e

# RepoExe Advanced Installer for RepoExe
REPO_URL="https://SjnExe.github.io/RepoExe"
REPO_LIST="$PREFIX/etc/apt/sources.list.d/repoexe.list"

echo "[*] Updating existing packages..."
pkg update -y


echo "[*] Adding RepoExe to sources.list.d..."
echo "deb [trusted=yes] $REPO_URL/ stable main" > "$REPO_LIST"

echo "[*] Syncing new repository index..."
pkg update -y

echo ""
echo "[*] RepoExe installed successfully! You can now search for and install packages using 'pkg i <package>'."
