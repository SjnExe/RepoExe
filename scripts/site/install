#!/bin/sh
set -e

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
REPO_URL="https://SjnExe.github.io/RepoExe"
KEYRING_DIR="${PREFIX}/etc/apt/keyrings"
KEY_FILE="${KEYRING_DIR}/repoexe.gpg"
SOURCES_LIST="${PREFIX}/etc/apt/sources.list.d/repoexe.list"

echo "=== RepoExe Setup ==="
echo "[*] Configuring APT repository..."

# Remove old legacy key locations
rm -f "${PREFIX}/etc/apt/trusted.gpg.d/repoexe.gpg"
rm -f "${PREFIX}/etc/apt/trusted.gpg.d/repoexe.asc"

mkdir -p "$KEYRING_DIR"
mkdir -p "${PREFIX}/etc/apt/sources.list.d"

echo "[*] Fetching GPG public key..."
curl -sL "${REPO_URL}/repoexe.gpg" -o "$KEY_FILE"

echo "[*] Adding repository source..."
echo "deb [arch=aarch64 signed-by=${KEY_FILE}] ${REPO_URL}/apt stable main" > "$SOURCES_LIST"

echo "[*] Updating APT package lists..."
apt update
echo "✓ RepoExe repository configured successfully!"
