# syntax=docker/dockerfile:1
FROM termux/termux-docker:aarch64

ENV PREFIX=/data/data/com.termux/files/usr     HOME=/data/data/com.termux/files/home     PATH=/data/data/com.termux/files/usr/bin:${PATH}     LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib

# Ensure /tmp exists, is world-writable, and grant ownership of Termux prefix to UID 1000
USER root
RUN mkdir -p /tmp /data/data/com.termux/files/usr/tmp  && chmod 1777 /tmp /data/data/com.termux/files/usr/tmp  && chown -R 1000:1000 /data/data/com.termux/files

USER 1000:1000
WORKDIR /data/data/com.termux/files/home

# Pin official Cloudflare CDN mirrors to bypass slow mirror fallbacks
RUN echo "deb https://packages-cf.termux.dev/apt/termux-main stable main" > ${PREFIX}/etc/apt/sources.list  && pkg update -y  && pkg upgrade -y  && pkg install -y       binutils       coreutils       findutils       grep       sed       gawk       tar       gzip       zstd       procps       python       python-pip       x11-repo       root-repo       glibc-repo  && echo "deb https://packages-cf.termux.dev/apt/termux-x11 x11 main" > ${PREFIX}/etc/apt/sources.list.d/x11.list  && echo "deb https://packages-cf.termux.dev/apt/termux-root root stable" > ${PREFIX}/etc/apt/sources.list.d/root.list  && echo "deb https://packages-cf.termux.dev/apt/termux-glibc glibc stable" > ${PREFIX}/etc/apt/sources.list.d/glibc.list  && pkg install -y       xorg-server-xvfb       xorg-xauth       gtk3       libcairo       libcanberra       pango       fontconfig       ttf-dejavu       desktop-file-utils       shared-mime-info       glibc-runner       patchelf  && pkg clean  && rm -rf ${PREFIX}/var/lib/apt/lists/*
