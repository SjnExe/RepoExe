# syntax=docker/dockerfile:1
FROM termux/termux-docker:aarch64

ENV PREFIX=/data/data/com.termux/files/usr \
    HOME=/data/data/com.termux/files/home \
    TERMUX_PREFIX=/data/data/com.termux/files/usr \
    TERMUX_APP_PACKAGE_MANAGER=apt \
    ANDROID_DATA=/data \
    ANDROID_ROOT=/system \
    TMPDIR=/data/data/com.termux/files/usr/tmp \
    TERM=xterm-256color \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PATH=/data/data/com.termux/files/usr/bin:${PATH} \
    LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib

USER root

# Create standard Android directories and shebang symlink to fully mimic Android OS
RUN mkdir -p /system/bin /system/etc /data/local/tmp /sdcard /tmp /data/data/com.termux/files/usr/tmp \
 && chmod 1777 /tmp /data/local/tmp /data/data/com.termux/files/usr/tmp \
 && ln -sf /data/data/com.termux/files/usr/bin/sh /system/bin/sh \
 && echo "ro.build.version.sdk=34" > /system/build.prop \
 && echo "ro.product.model=Termux Docker" >> /system/build.prop \
 && chown -R 1000:1000 /data/data/com.termux/files

USER 1000:1000
WORKDIR /data/data/com.termux/files/home

# Configure Termux mirrors (main, x11, root) excluding glibc
RUN echo "deb https://packages-cf.termux.dev/apt/termux-main stable main" > ${PREFIX}/etc/apt/sources.list \
 && pkg update -y \
 && pkg upgrade -y \
 && pkg install -y \
      x11-repo \
      root-repo \
 && echo "deb https://packages-cf.termux.dev/apt/termux-x11 x11 main" > ${PREFIX}/etc/apt/sources.list.d/x11.list \
 && echo "deb https://packages-cf.termux.dev/apt/termux-root root stable" > ${PREFIX}/etc/apt/sources.list.d/root.list \
 && pkg install -y \
      xorg-server-xvfb \
      xorg-xauth \
      gtk3 \
      libcanberra \
      ttf-dejavu \
      desktop-file-utils \
      shared-mime-info \
      curl \
      wget \
      git \
      diffutils \
      patch \
      nodejs \
 && pkg clean \
 && rm -rf ${PREFIX}/var/lib/apt/lists/*
