# syntax=docker/dockerfile:1
FROM termux/termux-docker:aarch64

ENV PREFIX=/data/data/com.termux/files/usr
ENV HOME=/data/data/com.termux/files/home
ENV PATH=${PREFIX}/bin:${PATH}
ENV LD_LIBRARY_PATH=${PREFIX}/lib

# Grant ownership of Termux files to non-root UID 1000
USER root
RUN chown -R 1000:1000 /data/data/com.termux/files

# Termux pkg requires non-root user (UID 1000)
USER 1000:1000

# Pre-install core testing utilities, Python, X11 & Root repos, GTK3 and DejaVu fonts using pkg
RUN pkg update -y  && pkg upgrade -y  && pkg install -y       binutils       coreutils       findutils       grep       sed       gawk       tar       gzip       zstd       procps       python       python-pip       x11-repo       root-repo  && pkg install -y       xorg-server-xvfb       xorg-xauth       gtk3       libcairo       libcanberra       pango       fontconfig       ttf-dejavu       desktop-file-utils       shared-mime-info  && pkg clean

WORKDIR /data/data/com.termux/files/home
