# syntax=docker/dockerfile:1
FROM termux/termux-docker:aarch64

ENV PREFIX=/data/data/com.termux/files/usr     HOME=/data/data/com.termux/files/home     PATH=/data/data/com.termux/files/usr/bin:${PATH}     LD_LIBRARY_PATH=/data/data/com.termux/files/usr/lib

# Ensure /tmp is world-writable and grant ownership of Termux prefix to UID 1000
USER root
RUN chmod 1777 /tmp  && chown -R 1000:1000 /data/data/com.termux/files

USER 1000:1000
WORKDIR /data/data/com.termux/files/home

# Pre-install core testing utilities, Python runtime, X11/GTK/Font dependencies, and clean APT cache in single layer
RUN pkg update -y  && pkg upgrade -y  && pkg install -y       binutils       coreutils       findutils       grep       sed       gawk       tar       gzip       zstd       procps       python       python-pip       x11-repo       root-repo  && pkg install -y       xorg-server-xvfb       xorg-xauth       gtk3       libcairo       libcanberra       pango       fontconfig       ttf-dejavu       desktop-file-utils       shared-mime-info  && pkg clean  && rm -rf ${PREFIX}/var/lib/apt/lists/*
