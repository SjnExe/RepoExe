+extern "C" int posix_spawn(
+    pid_t *pid,
+    const char *path,
+    const posix_spawn_file_actions_t *file_actions,
+    const posix_spawnattr_t *attrp,
+    char *const argv[],
+    char *const envp[]
+) {
+    typedef int (*posix_spawn_fn)(pid_t *, const char *, const posix_spawn_file_actions_t *, const posix_spawnattr_t *, char *const [], char *const []);
+    posix_spawn_fn real_posix_spawn = (posix_spawn_fn)dlsym(RTLD_NEXT, "posix_spawn");
+    char fn_buf[1024];
+    const char *new_path = termux_rewrite_path_r(path, fn_buf, sizeof(fn_buf));
+    if (real_posix_spawn) {
+        int ret = real_posix_spawn(pid, new_path, file_actions, attrp, argv, envp);
+        if ((ret == ENOEXEC || ret == ENOENT || ret == EACCES) && new_path && access(new_path, F_OK) == 0) {
+            int shebang_ret = try_posix_spawn_shebang(pid, new_path, file_actions, attrp, argv, envp);
+            if (shebang_ret == 0) return 0;
+        }
+        if ((ret != 0) && path && strchr(path, '/') == NULL) {
+            typedef int (*posix_spawnp_fn)(pid_t *, const char *, const posix_spawn_file_actions_t *, const posix_spawnattr_t *, char *const [], char *const []);
+            posix_spawnp_fn real_posix_spawnp = (posix_spawnp_fn)dlsym(RTLD_NEXT, "posix_spawnp");
+            if (real_posix_spawnp) {
+                return real_posix_spawnp(pid, path, file_actions, attrp, argv, envp);
+            }
+        }
+        return ret;
+    }
+    return -1;
+}

