+static void sigsys_handler(int sig, siginfo_t *info, void *context) {
+    if (sig == SIGSYS && context != NULL) {
+        ucontext_t *ctx = (ucontext_t *)context;
+        ctx->uc_mcontext. regs[0] = -ENOSYS;
+        ctx->uc_mcontext.pc += 4;
+    }
+}

+static void install_sigsys_handler(void) {
+    int (*real_sigaction)(int, const struct sigaction *, struct sigaction *) =
+        (int (*)(int, const struct sigaction *, struct sigaction *))dlsym(RTLD_NEXT, "sigaction");

+    struct sigaction sa;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+    sa.sa_sigaction = sigsys_handler;

+    if (real_sigaction) {
+        real_sigaction(SIGSYS, &sa, NULL);
+    } else {
+        sigaction(SIGSYS, &sa, NULL);
+    }
+}

+extern "C" int sigaction(int signum, const struct sigaction *act, struct sigaction *oldact) {
+    int (*real_sigaction)(int, const struct sigaction *, struct sigaction *) =
+        (int (*)(int, const struct sigaction *, struct sigaction *))dlsym(RTLD_NEXT, "sigaction");

+    if (signum == SIGSYS) {
+        if (oldact != NULL) {
+            sigemptyset(&oldact->sa_mask);
+            oldact->sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+            oldact->sa_sigaction = sigsys_handler;
+        }
+        return 0;
+    }

+    if (real_sigaction) {
+        return real_sigaction(signum, act, oldact);
+    }
+    return 0;
+}

+static const char *termux_rewrite_path(const char *filename) {
+    if (!filename) return filename;
+    static const char *prefix = "/data/data/com.termux/files/usr";
+    if (strncmp(filename, prefix, strlen(prefix)) == 0) {
+        return filename;
+    }
+    if (strcmp(filename, "/usr/bin/env") == 0) {
+        return "/data/data/com.termux/files/usr/bin/env";
+    }
+    if (strcmp(filename, "/bin/sh") == 0) {
+        return "/data/data/com.termux/files/usr/bin/sh";
+    }
+    if (strcmp(filename, "/bin/bash") == 0) {
+        return "/data/data/com.termux/files/usr/bin/bash";
+    }
+    if (strcmp(filename, "/usr/bin/node") == 0) {
+        if (access("/data/data/com.termux/files/usr/bin/node", X_OK) == 0) {
+            return "/data/data/com.termux/files/usr/bin/node";
+        }
+        return "/data/data/com.termux/files/usr/bin/bun";
+    }
+    if (strcmp(filename, "/usr/bin/python") == 0 || strcmp(filename, "/usr/bin/python3") == 0) {
+        return "/data/data/com.termux/files/usr/bin/python3";
+    }
+    if (strncmp(filename, "/usr/bin/", 9) == 0) {
+        thread_local static char buf[1024];
+        snprintf(buf, sizeof(buf), "/data/data/com.termux/files/usr/bin/%s", filename + 9);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strncmp(filename, "/bin/", 5) == 0) {
+        thread_local static char buf[1024];
+        snprintf(buf, sizeof(buf), "/data/data/com.termux/files/usr/bin/%s", filename + 5);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    return filename;
+}

+static int parse_shebang(const char *filename, char *interp_out, size_t interp_size, char *arg_out, size_t arg_size) {
+    int fd = open(filename, O_RDONLY);
+    if (fd < 0) return -1;
+    char line[512];
+    ssize_t n = read(fd, line, sizeof(line) - 1);
+    close(fd);
+    if (n < 3 || line[0] != '#' || line[1] != '!') return -1;
+    line[n] = '\0';
+    char *newline = strchr(line, '\n');
+    if (newline) *newline = '\0';
+    char *ptr = line + 2;
+    while (*ptr == ' ' || *ptr == '\t') ptr++;
+    if (*ptr == '\0') return -1;
+
+    char *interp = ptr;
+    while (*ptr && *ptr != ' ' && *ptr != '\t') ptr++;
+    if (*ptr) {
+        *ptr = '\0';
+        ptr++;
+        while (*ptr == ' ' || *ptr == '\t') ptr++;
+    }
+    snprintf(interp_out, interp_size, "%s", interp);
+    if (*ptr) {
+        snprintf(arg_out, arg_size, "%s", ptr);
+    } else {
+        arg_out[0] = '\0';
+    }
+    return 0;
+}

+extern "C" int execve(const char *filename, char *const argv[], char *const envp[]) {
+    typedef int (*execve_fn)(const char *, char *const [], char *const []);
+    execve_fn real_execve = (execve_fn)dlsym(RTLD_NEXT, "execve");
+    if (!real_execve) return -1;
+    const char *new_fn = termux_rewrite_path(filename);
+    int res = real_execve(new_fn, argv, envp);
+    if (res < 0 && errno == ENOENT && filename) {
+        char interp[256], shebang_arg[256];
+        if (parse_shebang(filename, interp, sizeof(interp), shebang_arg, sizeof(shebang_arg)) == 0) {
+            const char *rewritten_interp = termux_rewrite_path(interp);
+            size_t orig_argc = 0;
+            if (argv) { while (argv[orig_argc]) orig_argc++; }
+            size_t extra = (shebang_arg[0] != '\0') ? 2 : 1;
+            char **new_argv = (char **)malloc(sizeof(char *) * (orig_argc + extra + 1));
+            new_argv[0] = (char *)rewritten_interp;
+            size_t idx = 1;
+            if (shebang_arg[0] != '\0') {
+                new_argv[idx++] = shebang_arg;
+            }
+            new_argv[idx++] = (char *)filename;
+            for (size_t i = 1; i < orig_argc; i++) {
+                new_argv[idx++] = argv[i];
+            }
+            new_argv[idx] = NULL;
+            res = real_execve(rewritten_interp, new_argv, envp);
+            free(new_argv);
+        }
+    }
+    return res;
+}

