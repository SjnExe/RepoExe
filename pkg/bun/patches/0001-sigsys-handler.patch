+    char *space = strpbrk(line, " \t");
+    if (space) {
+        *space = '\0';
+        arg = space + 1;
+        while (*arg == ' ' || *arg == '\t') arg++;
+        if (*arg == '\0') arg = NULL;
+    }

+    char interp_buf[1024];
+    const char *rw_interp = termux_rewrite_path_r(interp, interp_buf, sizeof(interp_buf));

+    int orig_argc = 0;
+    if (argv) {
+        while (argv[orig_argc]) orig_argc++;
+    }

+    int extra = 2 + (arg ? 1 : 0);
+    int new_argc = (orig_argc > 0 ? orig_argc - 1 : 0) + extra;

+    char **new_argv = (char **)malloc(sizeof(char *) * (new_argc + 1));
+    if (!new_argv) return -1;

+    int idx = 0;
+    new_argv[idx++] = (char *)rw_interp;
+    if (arg) {
+        new_argv[idx++] = arg;
+    }
+    new_argv[idx++] = (char *)filename;

+    for (int i = 1; i < orig_argc; i++) {
+        new_argv[idx++] = argv[i];
+    }
+    new_argv[idx] = NULL;

+    typedef int (*posix_spawn_fn)(pid_t *, const char *, const posix_spawn_file_actions_t *, const posix_spawnattr_t *, char *const [], char *const []);
+    posix_spawn_fn real_posix_spawn = (posix_spawn_fn)dlsym(RTLD_NEXT, "posix_spawn");

+    int ret = -1;
+    if (real_posix_spawn) {
+        ret = real_posix_spawn(pid, rw_interp, file_actions, attrp, new_argv, envp);
+    }
+    free(new_argv);
