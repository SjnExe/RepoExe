+        if (ret == -1 && (errno == ENOENT || errno == ENOEXEC || errno == EACCES) && new_fn && access(new_fn, F_OK) == 0 && real_execve) {
+            ret = try_exec_shebang(new_fn, argv, envp, real_execve);
+        }
+        return ret;
+    }
+    return -1;
+}

