+static void sigsys_handler(int sig, siginfo_t *info, void *context) {
+    if (sig == SIGSYS && context != NULL) {
+        ucontext_t *ctx = (ucontext_t *)context;
+        ctx->uc_mcontext. regs[0] = -ENOSYS;
+        ctx->uc_mcontext.pc += 4;
+    }
+}

+static void install_sigsys_handler(void) {
+    int (*real_sigaction)(int, const struct sigaction *, struct sigaction *) =
+        (int (*)(int, const struct sigaction *, struct sigaction *))dlsym(RTLD_NEXT, "sigaction");

+    struct sigaction sa;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+    sa.sa_sigaction = sigsys_handler;

+    if (real_sigaction) {
+        real_sigaction(SIGSYS, &sa, NULL);
+    } else {
+        sigaction(SIGSYS, &sa, NULL);
+    }
+}

+extern "C" int sigaction(int signum, const struct sigaction *act, struct sigaction *oldact) {
+    int (*real_sigaction)(int, const struct sigaction *, struct sigaction *) =
+        (int (*)(int, const struct sigaction *, struct sigaction *))dlsym(RTLD_NEXT, "sigaction");

+    if (signum == SIGSYS) {
+        if (oldact != NULL) {
+            sigemptyset(&oldact->sa_mask);
+            oldact->sa_flags = SA_SIGINFO | SA_NODEFER | SA_ONSTACK;
+            oldact->sa_sigaction = sigsys_handler;
+        }
+        return 0;
+    }

+    if (real_sigaction) {
+        return real_sigaction(signum, act, oldact);
+    }
+    return 0;
+}

+static const char *get_termux_prefix(void) {
+    const char *p = getenv("PREFIX");
+    if (p && p[0]) return p;
+    p = getenv("TERMUX_PREFIX");
+    if (p && p[0]) return p;
+    return "/data/data/com.termux/files/usr";
+}

+static const char *get_termux_home(void) {
+    const char *h = getenv("HOME");
+    if (h && h[0]) return h;
+    return "/data/data/com.termux/files/home";
+}

+static const char *get_termux_tmp(void) {
+    const char *t = getenv("TMPDIR");
+    if (t && t[0]) return t;
+    static char tmpbuf[512];
+    const char *prefix = get_termux_prefix();
+    snprintf(tmpbuf, sizeof(tmpbuf), "%s/tmp", prefix);
+    return tmpbuf;
+}

+static const char *termux_rewrite_path_r(const char *filename, char *buf, size_t bufsize) {
+    if (!filename) return filename;
+    const char *prefix = get_termux_prefix();
+    if (strncmp(filename, prefix, strlen(prefix)) == 0) {
+        return filename;
+    }
+    const char *home = get_termux_home();
+    if (strncmp(filename, home, strlen(home)) == 0) {
+        return filename;
+    }
+    if (strcmp(filename, "/usr/bin/env") == 0) {
+        snprintf(buf, bufsize, "%s/bin/env", prefix);
+        return buf;
+    }
+    if (strcmp(filename, "/bin/sh") == 0) {
+        snprintf(buf, bufsize, "%s/bin/sh", prefix);
+        return buf;
+    }
+    if (strcmp(filename, "/bin/bash") == 0) {
+        snprintf(buf, bufsize, "%s/bin/bash", prefix);
+        return buf;
+    }
+    if (strncmp(filename, "/tmp/stage", 10) == 0) {
+        return filename;
+    }
+    if (strcmp(filename, "/tmp") == 0) {
+        snprintf(buf, bufsize, "%s", get_termux_tmp());
+        return buf;
+    }
+    if (strncmp(filename, "/tmp/", 5) == 0) {
+        const char *tmpdir = get_termux_tmp();
+        snprintf(buf, bufsize, "%s%s", tmpdir, filename + 4);
+        if (access(filename, F_OK) != 0 && access(buf, F_OK) == 0) return buf;
+        return filename;
+    }
+    if (strcmp(filename, "/usr/bin/node") == 0) {
+        snprintf(buf, bufsize, "%s/bin/node", prefix);
+        return buf;
+    }
+    if (strcmp(filename, "/usr/bin/python") == 0 || strcmp(filename, "/usr/bin/python3") == 0) {
+        snprintf(buf, bufsize, "%s/bin/python3", prefix);
+        return buf;
+    }
+    if (strncmp(filename, "/usr/bin/", 9) == 0) {
+        snprintf(buf, bufsize, "%s/bin/%s", prefix, filename + 9);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strncmp(filename, "/bin/", 5) == 0) {
+        snprintf(buf, bufsize, "%s/bin/%s", prefix, filename + 5);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strcmp(filename, "/etc") == 0) {
+        snprintf(buf, bufsize, "%s/etc", prefix);
+        return buf;
+    }
+    if (strncmp(filename, "/etc/", 5) == 0) {
+        snprintf(buf, bufsize, "%s/etc/%s", prefix, filename + 5);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strcmp(filename, "/usr/share") == 0) {
+        snprintf(buf, bufsize, "%s/share", prefix);
+        return buf;
+    }
+    if (strncmp(filename, "/usr/share/", 11) == 0) {
+        snprintf(buf, bufsize, "%s/share/%s", prefix, filename + 11);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strcmp(filename, "/var") == 0) {
+        snprintf(buf, bufsize, "%s/var", prefix);
+        return buf;
+    }
+    if (strncmp(filename, "/var/", 5) == 0) {
+        snprintf(buf, bufsize, "%s/var/%s", prefix, filename + 5);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strcmp(filename, "/root") == 0) {
+        snprintf(buf, bufsize, "%s", home);
+        return buf;
+    }
+    if (strncmp(filename, "/root/", 6) == 0) {
+        snprintf(buf, bufsize, "%s/%s", home, filename + 6);
+        if (access(filename, F_OK) != 0 && access(buf, F_OK) == 0) return buf;
+    }
+    if (strcmp(filename, "/home") == 0) {
+        snprintf(buf, bufsize, "%s", home);
+        return buf;
+    }
+    if (strncmp(filename, "/home/", 6) == 0) {
+        const char *rest = strchr(filename + 6, '/');
+        if (rest) {
+            snprintf(buf, bufsize, "%s%s", home, rest);
+        } else {
+            snprintf(buf, bufsize, "%s", home);
+        }
+        if (access(filename, F_OK) != 0 && access(buf, F_OK) == 0) return buf;
+    }
+    return filename;
+}

+typedef int (*execve_fn)(const char *, char *const [], char *const []);
+extern "C" char **environ;

+static int try_exec_shebang(const char *filename, char *const argv[], char *const envp[], execve_fn real_execve) {
+    if (!filename || access(filename, F_OK) != 0) return -1;

+    int fd = open(filename, O_RDONLY);
+    if (fd < 0) return -1;

+    char header[512];
+    ssize_t n = read(fd, header, sizeof(header) - 1);
+    close(fd);

+    if (n < 3 || header[0] != '#' || header[1] != '!') return -1;

+    header[n] = '\0';
+    char *newline = strchr(header, '\n');
+    if (newline) *newline = '\0';

+    char *cr = strchr(header, '\r');
+    if (cr) *cr = '\0';

+    char *line = header + 2;
+    while (*line == ' ' || *line == '\t') line++;
+    if (*line == '\0') return -1;

+    char *interp = line;
+    char *arg = NULL;
+    char *space = strpbrk(line, " \t");
+    if (space) {
+        *space = '\0';
+        arg = space + 1;
+        while (*arg == ' ' || *arg == '\t') arg++;
+        if (*arg == '\0') arg = NULL;
+    }

+    char interp_buf[1024];
+    const char *rw_interp = termux_rewrite_path_r(interp, interp_buf, sizeof(interp_buf));

+    int orig_argc = 0;
+    if (argv) {
+        while (argv[orig_argc]) orig_argc++;
+    }

+    int extra = 2 + (arg ? 1 : 0);
+    int new_argc = (orig_argc > 0 ? orig_argc - 1 : 0) + extra;

+    char **new_argv = (char **)malloc(sizeof(char *) * (new_argc + 1));
+    if (!new_argv) return -1;

+    int idx = 0;
+    new_argv[idx++] = (char *)rw_interp;
+    if (arg) {
+        new_argv[idx++] = arg;
+    }
+    new_argv[idx++] = (char *)filename;

+    for (int i = 1; i < orig_argc; i++) {
+        new_argv[idx++] = argv[i];
+    }
+    new_argv[idx] = NULL;

+    int ret = real_execve(rw_interp, new_argv, envp);
+    free(new_argv);
+    return ret;
+}

+static int execve_with_shebang_fallback(const char *filename, char *const argv[], char *const envp[], execve_fn real_execve) {
+    char fn_buf[1024];
+    const char *new_fn = termux_rewrite_path_r(filename, fn_buf, sizeof(fn_buf));
+    int ret = real_execve(new_fn, argv, envp);
+    if (ret == -1 && (errno == ENOENT || errno == ENOEXEC || errno == EACCES) && new_fn && access(new_fn, F_OK) == 0) {
+        ret = try_exec_shebang(new_fn, argv, envp, real_execve);
+    }
+    if (ret == -1 && errno == ENOENT && filename && strchr(filename, '/') == NULL) {
+        typedef int (*execvpe_fn)(const char *, char *const [], char *const []);
+        execvpe_fn real_execvpe = (execvpe_fn)dlsym(RTLD_NEXT, "execvpe");
+        if (real_execvpe) {
+            ret = real_execvpe(filename, argv, envp);
+            if (ret == -1 && (errno == ENOENT || errno == ENOEXEC || errno == EACCES)) {
+                char path_env[2048];
+                const char *path = getenv("PATH");
+                if (path && path[0]) {
+                    snprintf(path_env, sizeof(path_env), "%s", path);
+                    char *dir = strtok(path_env, ":");
+                    while (dir) {
+                        char full_path[1024];
+                        snprintf(full_path, sizeof(full_path), "%s/%s", dir, filename);
+                        if (access(full_path, F_OK) == 0) {
+                            ret = try_exec_shebang(full_path, argv, envp, real_execve);
+                            if (ret == 0) break;
+                        }
+                        dir = strtok(NULL, ":");
+                    }
+                }
+            }
+        }
+    }
+    return ret;
+}

+extern "C" int execve(const char *filename, char *const argv[], char *const envp[]) {
+    execve_fn real_execve = (execve_fn)dlsym(RTLD_NEXT, "execve");
+    if (!real_execve) return -1;
+    return execve_with_shebang_fallback(filename, argv, envp, real_execve);
+}

+extern "C" int execv(const char *filename, char *const argv[]) {
+    execve_fn real_execve = (execve_fn)dlsym(RTLD_NEXT, "execve");
+    if (!real_execve) return -1;
+    return execve_with_shebang_fallback(filename, argv, environ, real_execve);
+}

+extern "C" int execvp(const char *filename, char *const argv[]) {
+    typedef int (*execvp_fn)(const char *, char *const []);
+    execvp_fn real_execvp = (execvp_fn)dlsym(RTLD_NEXT, "execvp");
+    execve_fn real_execve = (execve_fn)dlsym(RTLD_NEXT, "execve");
+    char fn_buf[1024];
+    const char *new_fn = termux_rewrite_path_r(filename, fn_buf, sizeof(fn_buf));
+    if (real_execvp) {
+        int ret = real_execvp(new_fn, argv);
+        if (ret == -1 && (errno == ENOENT || errno == ENOEXEC || errno == EACCES) && new_fn && access(new_fn, F_OK) == 0 && real_execve) {
+            ret = try_exec_shebang(new_fn, argv, environ, real_execve);
+        }
+        return ret;
+    }
+    return -1;
+}

+extern "C" int execvpe(const char *filename, char *const argv[], char *const envp[]) {
+    typedef int (*execvpe_fn)(const char *, char *const [], char *const []);
+    execvpe_fn real_execvpe = (execvpe_fn)dlsym(RTLD_NEXT, "execvpe");
