+static const char *termux_rewrite_path(const char *filename) {
+    if (!filename) return filename;
+    static const char *prefix = "/data/data/com.termux/files/usr";
+    if (strncmp(filename, prefix, strlen(prefix)) == 0) {
+        return filename;
+    }
+    if (strcmp(filename, "/usr/bin/env") == 0) {
+        return "/data/data/com.termux/files/usr/bin/env";
+    }
+    if (strcmp(filename, "/bin/sh") == 0) {
+        return "/data/data/com.termux/files/usr/bin/sh";
+    }
+    if (strcmp(filename, "/bin/bash") == 0) {
+        return "/data/data/com.termux/files/usr/bin/bash";
+    }
+    if (strcmp(filename, "/usr/bin/node") == 0) {
+        if (access("/data/data/com.termux/files/usr/bin/node", X_OK) == 0) {
+            return "/data/data/com.termux/files/usr/bin/node";
+        }
+        return "/data/data/com.termux/files/usr/bin/bun";
+    }
+    if (strcmp(filename, "/usr/bin/python") == 0 || strcmp(filename, "/usr/bin/python3") == 0) {
+        return "/data/data/com.termux/files/usr/bin/python3";
+    }
+    if (strncmp(filename, "/usr/bin/", 9) == 0) {
+        thread_local static char buf[1024];
+        snprintf(buf, sizeof(buf), "/data/data/com.termux/files/usr/bin/%s", filename + 9);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    if (strncmp(filename, "/bin/", 5) == 0) {
+        thread_local static char buf[1024];
+        snprintf(buf, sizeof(buf), "/data/data/com.termux/files/usr/bin/%s", filename + 5);
+        if (access(buf, F_OK) == 0) return buf;
+    }
+    return filename;
+}
