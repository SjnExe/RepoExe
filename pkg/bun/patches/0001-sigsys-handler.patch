+extern "C" int execve(const char *filename, char *const argv[], char *const envp[]) {
+    typedef int (*execve_fn)(const char *, char *const [], char *const []);
+    execve_fn real_execve = (execve_fn)dlsym(RTLD_NEXT, "execve");
+    const char *new_fn = termux_rewrite_path(filename);
+    if (real_execve) {
+        return real_execve(new_fn, argv, envp);
+    }
+    return -1;
+}
