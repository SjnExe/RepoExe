#!/bin/sh
set -e

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
REPO_URL="https://sjnexe.github.io/RepoExe"
SOURCES_DIR="$PREFIX/etc/apt/sources.list.d"
KEYRING_DIR="$PREFIX/etc/apt/trusted.gpg.d"
LIST_FILE="$SOURCES_DIR/repoexe.list"
KEY_FILE="$KEYRING_DIR/repoexe.asc"
REPOEXE_VERSION_FALLBACK="1.0.0"
REPOEXE_VERSION="$(dpkg-query -W -f='${Version}' repoexe 2>/dev/null || echo "$REPOEXE_VERSION_FALLBACK")"

# Terminal Colors
if [ -t 1 ]; then
  BOLD='\033[1m'
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  RESET='\033[0m'
else
  BOLD=''
  GREEN=''
  RED=''
  YELLOW=''
  CYAN=''
  RESET=''
fi

show_help() {
  printf "${BOLD}RepoExe Management CLI v%s${RESET}\n\n" "$REPOEXE_VERSION"
  printf "${BOLD}USAGE:${RESET}\n"
  printf "  repoexe <command> [options]\n\n"
  printf "${BOLD}COMMANDS & OPTIONS:${RESET}\n"
  printf "  ${CYAN}status, -s, --status${RESET}     Check RepoExe APT repository integration status\n"
  printf "  ${CYAN}enable, -e, --enable${RESET}     Enable RepoExe APT repository source\n"
  printf "  ${CYAN}disable, -d, --disable${RESET}   Disable RepoExe APT repository source\n"
  printf "  ${CYAN}version, -v, --version${RESET}   Print CLI version\n"
  printf "  ${CYAN}help, -h, --help${RESET}         Show this help menu\n"
}

check_status() {
  printf "${BOLD}=== RepoExe Status ===${RESET}\n"
  if [ -f "$LIST_FILE" ]; then
    printf "  APT Source:   [${GREEN}ENABLED${RESET}]  (%s)\n" "$LIST_FILE"
  else
    printf "  APT Source:   [${RED}DISABLED${RESET}]\n"
  fi

  if [ -s "$KEY_FILE" ] && grep -q "BEGIN PGP PUBLIC KEY BLOCK" "$KEY_FILE" 2>/dev/null; then
    printf "  Signing Key:  [${GREEN}OK${RESET}]       (%s)\n" "$KEY_FILE"
  else
    printf "  Signing Key:  [${YELLOW}MISSING${RESET}]\n"
  fi
}

enable_repo() {
  mkdir -p "$SOURCES_DIR" "$KEYRING_DIR"
  if [ ! -s "$KEY_FILE" ] || ! grep -q "BEGIN PGP PUBLIC KEY BLOCK" "$KEY_FILE" 2>/dev/null; then
    if ! command -v curl >/dev/null 2>&1; then
      printf "${RED}Error: 'curl' is required to fetch repository signing key.${RESET}\n" >&2
      exit 1
    fi
    TMP_KEY="${KEY_FILE}.tmp.$$"
    trap 'rm -f "$TMP_KEY"' EXIT INT TERM
    if ! curl -fsSL "$REPO_URL/repoexe.gpg" -o "$TMP_KEY"; then
      rm -f "$TMP_KEY"
      trap - EXIT INT TERM
      printf "${RED}Error: Failed to download signing key from $REPO_URL/repoexe.gpg${RESET}\n" >&2
      exit 1
    fi
    if ! grep -q "BEGIN PGP PUBLIC KEY BLOCK" "$TMP_KEY" 2>/dev/null; then
      rm -f "$TMP_KEY"
      trap - EXIT INT TERM
      printf "${RED}Error: Downloaded signing key is invalid or corrupted.${RESET}\n" >&2
      exit 1
    fi
    mv -f "$TMP_KEY" "$KEY_FILE"
    trap - EXIT INT TERM
  fi
  echo "deb [signed-by=$KEY_FILE] $REPO_URL/apt stable main" > "$LIST_FILE"
  printf "${GREEN}✓ RepoExe APT repository enabled.${RESET}\n"
}

disable_repo() {
  rm -f "$LIST_FILE"
  printf "${YELLOW}✓ RepoExe APT repository disabled.${RESET}\n"
}

case "$1" in
  status|-s|--status)
    check_status
    ;;
  enable|-e|--enable)
    enable_repo
    ;;
  disable|-d|--disable)
    disable_repo
    ;;
  version|-v|--version)
    printf "repoexe v%s\n" "$REPOEXE_VERSION"
    ;;
  help|-h|--help)
    show_help
    ;;
  "")
    enable_repo
    printf "\n${BOLD}Synchronizing APT package indexes...${RESET}\n"
    if command -v apt-get >/dev/null 2>&1; then
      apt-get update -o Acquire::Retries=3 -qq || apt-get update || true
      printf "\n${BOLD}Installing RepoExe CLI helper...${RESET}\n"
      apt-get install -y -o Acquire::Retries=3 repoexe 2>/dev/null || {
        printf "${YELLOW}Notice: 'repoexe' package is not yet available in the repository.${RESET}\n"
      }
    elif command -v pkg >/dev/null 2>&1; then
      pkg update -y 2>/dev/null || true
      pkg install -y repoexe 2>/dev/null || true
    fi
    printf "\n${GREEN}✓ RepoExe repository configuration complete!${RESET}\n"
    printf "Install packages using: '${CYAN}pkg install <pkg>${RESET}'\n"
    ;;
  *)
    printf "${RED}Error: Unknown command '$1'. Run 'repoexe --help' for usage.${RESET}\n"
    exit 1
    ;;
esac
