#!/bin/sh
set -e

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
REPO_URL="https://sjnexe.github.io/RepoExe"
SOURCES_DIR="$PREFIX/etc/apt/sources.list.d"
SOURCES_FILE="$SOURCES_DIR/repoexe.sources"
REPOEXE_VERSION="$(dpkg-query -W -f='${Version}' repoexe 2>/dev/null || echo "1.0.0")"

# Terminal Colors
if [ -t 1 ]; then
  BOLD='\033[1m'
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  RESET='\033[0m'
else
  BOLD=''
  GREEN=''
  RED=''
  YELLOW=''
  CYAN=''
  RESET=''
fi

write_sources_file() {
  local comps="${1:-${REPOEXE_COMPONENTS:-main gui}}"
  cat << EOF > "$SOURCES_FILE"
Types: deb
URIs: https://sjnexe.github.io/RepoExe/apt
Suites: stable
Components: $comps
Signed-By:
 -----BEGIN PGP PUBLIC KEY BLOCK-----
